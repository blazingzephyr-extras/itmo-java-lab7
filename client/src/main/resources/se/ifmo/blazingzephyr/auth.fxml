<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER"
      spacing="20.0"
      xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="se.ifmo.blazingzephyr.controllers.AuthController">

   <children>
      <ChoiceBox fx:id="languageChoiceBox" />

      <Label fx:id="loginLabel" text="Логин" />
      <TextField fx:id="loginTextField"/>
      
      <Label fx:id="passwordLabel"  text="Пароль" />
      <TextField fx:id="passwordTextField"/>

      <CheckBox fx:id="registerNewCheckBox" onAction="#flipMode" />
      
      <Button fx:id="loginButton" text="Войти" onAction="#login" />
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
